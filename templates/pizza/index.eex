















	<main class="sections">
	<%= for pizz <- pizza do %>
    	<div class="section">

			<section class="picture_box">
				<img src="../Grafiskt material/<%=pizz.picture_id %>">
			</section>
			<section class="text_area">
				<p><%= html_escape(pizz.name) %>  </p>
			</section>
			<section class="button_box">
				<form action="" method="post">
					<input type="submit" value="anpassa">
					<input type="submit" value="köp">
				</form>
			<section>

		</div>
	<% end %>
	</main>







<a href="/fruits/new">Add new fruit</a>
