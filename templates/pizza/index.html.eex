<main class="sections">
	<%= for pizz <- pizza do %>
    <div class="section">
		<section class="picture_box">
			<img src="../Grafiskt material/<%=pizz.img %>">
		</section>
		<section class="text_area">
			<p><%= html_escape(pizz.name) %>  </p>
		</section>
		<section class="button_box">
			<form action="edit">
				<input id="wheat" type="submit" value="anpassa">

			</form>
			<form action="basket">
				<input id="green" type="submit" value="köp">
			</form>
		<section>
	</div>
	<% end %>
	</main>







<a href="/fruits/new">Add new fruit</a>
